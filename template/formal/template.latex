\documentclass[$if(fontsize)$$fontsize/last$$elseif(default-fontsize)$$default-fontsize$$else$11pt$endif$,$if(papersize)$$papersize/last$paper$elseif(default-papersize)$$default-papersize$paper$else$a4paper$endif$,$for(classoption)$$classoption$$sep$,$endfor$]{$if(documentclass)$$documentclass/last$$elseif(default-documentclass)$$default-documentclass$$else$article$endif$}

% 頁面邊界設定
\usepackage[$if(geometry)$$for(geometry)$$geometry$$sep$,$endfor$$elseif(default-geometry)$$for(default-geometry)$$default-geometry$$sep$,$endfor$$else$a4paper,margin=2.0cm$endif$]{geometry}

% 顏色與繪圖套件
\usepackage{xcolor}
\usepackage{tcolorbox}
\tcbuselibrary{skins,breakable}

% 數學套件
\usepackage{amsmath,amssymb}
\newcommand{\pu}[1]{\,\mathrm{#1}}

% 章節標題編號控制：預設不自動編號，以 Markdown 原文為準；若有指定 numbersections 則啟用
$if(numbersections)$
\setcounter{secnumdepth}{$if(secnumdepth)$$secnumdepth/last$$elseif(default-secnumdepth)$$default-secnumdepth$$else$5$endif$}
$else$
\setcounter{secnumdepth}{-\maxdimen}
$endif$

% 分隔線（---）擴展至頁面全寬，使用細緻灰線
\NewCommandCopy\origrule\rule
\RenewDocumentCommand{\rule}{O{0pt} m m}{%
  \ifdim#2=0.5\linewidth
    \vspace{-0.2em}%
    {\color{black!25}\origrule[#1]{\linewidth}{0.6pt}}%
    \vspace{-0.2em}%
  \else
    \origrule[#1]{#2}{#3}%
  \fi
}

% 頁首頁尾設定：簡潔正式風格，頁首留空，頁尾中央頁碼
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[C]{\thepage}

% Markdown 段落間距排版：parskip，首行不縮排，緊湊正式行距
\usepackage{parskip}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4.5pt plus 1pt minus 1pt}
\linespread{1.08}

% 中文與字體設定
\usepackage{fontspec}
\usepackage{xeCJK}
\usepackage{ifthen}

% 將引號與撇號（' / ’ / “ / ”）歸類為西文字元，避免被 xeCJK 誤判為全形 CJK 標點而在後方加入多餘空白
\xeCJKDeclareCharClass{Default}{"2018, "2019, "201C, "201D}

% 讀取使用者指定的 font 變數，預設為 noto-serif-tc，若有多個值取最後一個（-V 覆蓋 md；template.yaml 的 default-font 優先序最低）
\def\docfont{$if(default-font)$$default-font$$else$noto-serif-tc$endif$}
$for(font)$
\def\docfont{$font$}
$endfor$

% 根據 font 變數動態套用字體
\ifthenelse{\equal{\docfont}{times} \OR \equal{\docfont}{times new roman} \OR \equal{\docfont}{times-new-roman} \OR \equal{\docfont}{Times New Roman} \OR \equal{\docfont}{Times}}{%
  % Times New Roman 相容字體：直接採用 TeX Live 官方 100% 相容之 TeX Gyre Termes
  \setmainfont{TeX Gyre Termes}%
  \setCJKmainfont{Noto Serif CJK TC}[%
    BoldFont={Noto Serif CJK TC Bold},%
    AutoFakeBold=2.5,%
    AutoFakeSlant=true%
  ]%
  \setCJKsansfont{Noto Sans CJK TC}[%
    BoldFont={Noto Sans CJK TC Bold},%
    AutoFakeBold=2.0,%
    AutoFakeSlant=true%
  ]%
}{%
  \ifthenelse{\equal{\docfont}{sans} \OR \equal{\docfont}{noto sans tc} \OR \equal{\docfont}{noto-sans-tc} \OR \equal{\docfont}{noto-sans} \OR \equal{\docfont}{noto sans} \OR \equal{\docfont}{Noto Sans TC} \OR \equal{\docfont}{Noto Sans} \OR \equal{\docfont}{sans-serif}}{%
    % Noto Sans + Noto Sans CJK TC
    \setmainfont{Noto Sans}%
    \setsansfont{Noto Sans}%
    \setCJKmainfont{Noto Sans CJK TC}[%
      BoldFont={Noto Sans CJK TC Bold},%
      AutoFakeBold=2.2,%
      AutoFakeSlant=true%
    ]%
    \setCJKsansfont{Noto Sans CJK TC}[%
      BoldFont={Noto Sans CJK TC Bold},%
      AutoFakeBold=2.2,%
      AutoFakeSlant=true%
    ]%
    \renewcommand{\familydefault}{\sfdefault}%
  }{%
    % 預設：Noto Serif + Noto Serif CJK TC
    \setmainfont{Noto Serif}%
    \setsansfont{Noto Sans}%
    \setCJKmainfont{Noto Serif CJK TC}[%
      BoldFont={Noto Serif CJK TC Bold},%
      AutoFakeBold=2.5,%
      AutoFakeSlant=true%
    ]%
    \setCJKsansfont{Noto Sans CJK TC}[%
      BoldFont={Noto Sans CJK TC Bold},%
      AutoFakeBold=2.0,%
      AutoFakeSlant=true%
    ]%
  }%
}

% 等寬程式碼字型設定
\IfFontExistsTF{Noto Sans Mono}{%
  \setmonofont{Noto Sans Mono}[Scale=0.92]%
}{%
  \setmonofont{Latin Modern Mono}[Scale=0.92]%
}
\IfFontExistsTF{Noto Sans Mono CJK TC}{%
  \setCJKmonofont{Noto Sans Mono CJK TC}[%
    Scale=0.92,%
    BoldFont={Noto Sans Mono CJK TC Bold},%
    AutoFakeBold=2.0%
  ]%
}{%
  \setCJKmonofont{Noto Sans CJK TC}[%
    Scale=0.92,%
    BoldFont={Noto Sans CJK TC Bold},%
    AutoFakeBold=2.0%
  ]%
}

% 程式碼區塊樣式（現代工程正式風格：淺灰底色、細邊框、支援自動折行，不顯示換行箭頭）
\usepackage{fvextra}
\fvset{%
  breaklines=true,%
  breakanywhere=true,%
  breaksymbolleft={},%
  breaksymbolright={},%
  breaksymbolsepleft=0pt,%
  breaksymbolsepright=0pt,%
  breaksymbolindentleft=0pt,%
  breaksymbolindentright=0pt%
}

\definecolor{codebg}{HTML}{F6F8FA}
\definecolor{codeframe}{HTML}{D0D7DE}

$if(highlighting-macros)$
$highlighting-macros$
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{%
  commandchars=\\\{\},%
  breaklines=true,%
  breakanywhere=true,%
  breaksymbolleft={},%
  breaksymbolright={},%
  breaksymbolsepleft=0pt,%
  breaksymbolsepright=0pt,%
  breaksymbolindentleft=0pt,%
  breaksymbolindentright=0pt,%
  fontsize=\small%
}
\renewenvironment{Shaded}{%
  \vspace{0.4em}%
  \begin{tcolorbox}[
    breakable,
    enhanced,
    colback=codebg,
    colframe=codeframe,
    boxrule=0.5pt,
    arc=3pt,
    left=3.5mm,
    right=3.5mm,
    top=2.5mm,
    bottom=2.5mm,
    boxsep=0pt
  ]%
}{%
  \end{tcolorbox}%
  \vspace{0.4em}%
}
$endif$

% 對無指定語言之原始 verbatim 區塊亦套用灰底邊框樣式
\tcolorboxenvironment{verbatim}{%
  breakable,%
  enhanced,%
  colback=codebg,%
  colframe=codeframe,%
  boxrule=0.5pt,%
  arc=3pt,%
  left=3.5mm,%
  right=3.5mm,%
  top=2.5mm,%
  bottom=2.5mm,%
  boxsep=0pt%
}

% 引用區塊樣式（左側灰色垂直飾條）
\definecolor{quoteborder}{HTML}{D0D7DE}
\renewenvironment{quote}{%
  \vspace{0.3em}%
  \begin{tcolorbox}[
    breakable,
    enhanced,
    blanker,
    borderline west={2.5pt}{0pt}{quoteborder},
    left=3.5mm,
    top=1.5mm,
    bottom=1.5mm
  ]%
}{%
  \end{tcolorbox}%
  \vspace{0.3em}%
}

% 表格相關套件
\usepackage{longtable,booktabs,array}
\usepackage{calc}
\usepackage{caption}
\captionsetup[table]{skip=6pt}
\newcounter{none} % for unnumbered tables in pandoc 3
\usepackage{etoolbox}
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}%
\makeatother
\IfFileExists{footnotehyper.sty}{\usepackage{footnotehyper}}{\usepackage{footnote}}
\makesavenoteenv{longtable}
\renewcommand{\arraystretch}{1.25}
\setlength{\tabcolsep}{8pt}

% 圖片處理套件與大小自適應（支援 Pandoc 3.x 之 pandocbounded）
\usepackage{graphicx}
\makeatletter
\newsavebox\pandoc@box
\providecommand*\pandocbounded[1]{% scales image to fit in text height/width
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi% select the smaller of both
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}%
  \fi%
}
\def\fps@figure{htbp}
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}

% 超連結樣式
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=black,
  filecolor=black,
  citecolor=black,
  urlcolor=blue!75!black,
  breaklinks=true,
  pdfcreator={LaTeX via Pandoc}
}

% 列表緊密排列支援
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}%
}

% 標題與文章中繼資料排版：動態自適應間距，無作者或日期時不留空
$if(subtitle)$
\newcommand{\docsubtitle}{$subtitle$}
$endif$

\makeatletter
\def\@maketitle{%
  \null
  \vspace{-1.0em}%
  \begin{center}%
    {\LARGE\bfseries \@title \par}%
    $if(subtitle)$
    \vspace{0.4em}%
    {\large \docsubtitle \par}%
    $endif$
    $if(author)$
    \vspace{0.6em}%
    {\normalsize \@author \par}%
    $endif$
    $if(date)$
    \vspace{0.3em}%
    {\footnotesize \color{black!70} \@date \par}%
    $endif$
  \end{center}%
  \par
  \vspace{0.8em}%
}
\makeatother

$if(title)$
\title{$title$$if(thanks)$\thanks{$thanks$}$endif$}
$endif$
$if(author)$
\author{$for(author)$$author$$sep$ \and $endfor$}
$else$
\author{}
$endif$
$if(date)$
\date{$date$}
$else$
\date{}
$endif$

\begin{document}

$if(title)$
\maketitle
\thispagestyle{fancy}
$if(abstract)$
\begin{abstract}
$abstract$
\end{abstract}
$endif$
$endif$

$for(include-before)$
$include-before$

$endfor$

$if(toc)$
{
\setcounter{tocdepth}{$if(toc-depth)$$toc-depth/last$$elseif(default-toc-depth)$$default-toc-depth$$else$3$endif$}
\tableofcontents
\vspace{1.5em}
}
$endif$

$body$

$for(include-after)$
$include-after$

$endfor$

\end{document}
